{
  "schema_version": 1,
  "family": "TASK_SCOPE_CORE",
  "note": "Expected outcomes are written from the frozen task contract, not recorded from a run. Owned paths are compared as escaped display text, which is unambiguous and reviewable; the raw byte round-trip is asserted separately by the arbitrary-byte case. Where two spellings of one scope are expected to produce the same authority, the digests below are equal on purpose.",
  "zero_tolerance": [
    "repository_mutations",
    "local_state_writes",
    "repository_defined_executions"
  ],
  "platform_restricted_cases": "A case may declare a platform restriction. It is reported as skipped with its restriction named on machines it does not apply to, and never dropped from the listing.",
  "cases": [
    {
      "id": "simple_file_scope",
      "description": "One file declared, shown, and ended. The shape every other case is a deviation from.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "directory_component_scope",
      "description": "A directory scope. Owning 'src' owns everything under it by component, which the membership tests pin down separately.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:06052847344cabe113bebcde29ce63d5e92ba3ec3caaa2898d467671a3300297",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "nonexistent_future_path",
      "description": "Declaring a path that does not exist yet - the normal case when the task is about to create it. Scope is a declaration, not an observation.",
      "expect": {
        "active_after_end": false,
        "declared_path_exists": false,
        "digest_while_active": "sha256:3a746521682e2b63bbd74539768f9a3bdc2cc3c6c81d5de8bf987585fdd6ec88",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/new_module.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "duplicate_scope",
      "description": "The same path declared twice is one scope, and its digest equals the single-declaration digest.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "overlapping_scopes",
      "description": "'src' and 'src/strategy.py' both stay. The narrower declaration was written on purpose and does not disappear into the wider one.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:1edb39494c73b3ce38941446f30e83866bd29ea0fc2d7d6195fdcc8c950b14e6",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src",
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "trailing_separator",
      "description": "'src/', './src' and 'src//' are three spellings of one path. They collapse to one root with the plain directory digest.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:06052847344cabe113bebcde29ce63d5e92ba3ec3caaa2898d467671a3300297",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "literal_metacharacter_names",
      "description": "Every declared name here is a filename, not a pattern: glob characters, pathspec magic, and arguments that look like flags. Nothing expands.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:9a88843e9e48a9d52ec85becdd2ec14612162a99dce1af4cfbab9c6b61a2311b",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "*",
          "--help",
          "-a",
          ":(glob)vendor",
          ":(top)",
          "?",
          "[abc]"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "whitespace_names",
      "description": "Names containing a space, a tab and a newline. Stored literally, rendered escaped, and the newline does not become a second output row.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:1c45725bd613b8d6dbe26aaf38d620de701582ead74173e941c0f4f8fc3f77e6",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "newline\\nname",
          "space name",
          "tab\\tname"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "subdirectory_invocation",
      "description": "'--own ../src/strategy.py' typed from tests/ means the same scope as declaring it from the root, and produces the same digest.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "scope_rejections",
      "description": "Absolute paths, parent escapes, the repository root, the Git administrative directory, and '..' after a named component. All refused, and none leaves a task behind.",
      "expect": {
        "active_after_rejections": false,
        "rejection_exit_codes": [
          3,
          3,
          3,
          3,
          3,
          3,
          3
        ]
      }
    },
    {
      "id": "foreign_staged_preserved",
      "description": "A repository with staged work it did not ask AIQE about. The index is byte-identical across start, status and end.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0,
          0
        ],
        "index_unchanged": true,
        "owned_while_active": [
          "src/strategy.py"
        ],
        "staged_paths": [
          "foreign.txt"
        ],
        "staged_unchanged": true,
        "terminal_safe": true
      }
    },
    {
      "id": "repository_defined_execution",
      "description": "A repository pointing at commands every way it can - clean filter, fsmonitor, shell aliases, an executable hook. Declaring a task runs none of them.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "linked_worktree_isolation",
      "description": "Two linked worktrees hold two independent tasks. Ending one does not touch the other, and the main worktree has no task at all.",
      "expect": {
        "b_survives_a_end": [
          "src/b.py"
        ],
        "exit_codes": [
          0,
          0,
          0,
          0,
          0
        ],
        "main_worktree_has_no_task": true,
        "task_ids_differ": true,
        "terminal_safe": true,
        "worktree_a_owned": [
          "src/a.py"
        ],
        "worktree_b_owned": [
          "src/b.py"
        ]
      }
    },
    {
      "id": "concurrent_start",
      "description": "Two real processes racing to start a task in one worktree. One wins, one is refused, and exactly one valid record exists.",
      "expect": {
        "refusals": 1,
        "successes": 1,
        "unexpected_exits": 0,
        "valid_active_records": 1
      }
    },
    {
      "id": "interrupted_write",
      "description": "A process killed mid-write leaves a temporary file that was never renamed. It is not a task: status says so, and the next start succeeds.",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:75d833ec34bdcfabc212125d65cf79801e0d301da979ccd7d5163f2c37db9486",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "status_before_recovery_shows_no_task": true,
        "terminal_safe": true
      }
    },
    {
      "id": "corrupt_record_recovery",
      "description": "An active record that cannot be read is unknown, not unsupported: status and start exit 2. 'task end' discards it, and that is the documented way out.",
      "expect": {
        "active_after_end": false,
        "exit_codes": [
          2,
          2,
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/strategy.py"
        ],
        "terminal_safe": true
      }
    },
    {
      "id": "unsafe_state_location",
      "description": "A symlink planted where AIQE's private state belongs. AIQE refuses rather than writing through it to somewhere it never promised to write.",
      "expect": {
        "exit_codes": [
          3
        ],
        "wrote_through_symlink": false
      }
    },
    {
      "id": "non_utf8_owned_path",
      "description": "An owned path whose bytes are not valid UTF-8, declared through the real entry point with byte-preserving argv. The stored bytes equal the bytes typed.",
      "platform": "linux",
      "expect": {
        "active_after_end": false,
        "digest_while_active": "sha256:f2911f2b7866ccd8dc7ce8903c7ce8191ab539404005831b53c5b9dce35f86ac",
        "exit_codes": [
          0,
          0,
          0
        ],
        "owned_while_active": [
          "src/tracked-\\xe9\\xff.dat"
        ],
        "raw_bytes_roundtrip": true,
        "terminal_safe": true
      }
    }
  ]
}
